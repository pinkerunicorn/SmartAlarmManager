            "columns": [
                {
                    "caption": "Instanz",
                    "name": "InstanceID",
                    "width": "auto",
                    "add": 0,
                    "edit": { "type": "SelectInstance" }
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Überwachte Variablen"
        },
        {
            "type": "List",
            "name": "MonitoredVariables",
            "caption": "Variablen",
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Sensor/Auslöser",
