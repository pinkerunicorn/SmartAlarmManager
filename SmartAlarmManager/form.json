                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            { "caption": "Alarm (mit Eskalation)", "value": 0 },
                            { "caption": "Info / Türklingel (Einmalig)", "value": 1 }
                        ]
                    }
                },
                {
                    "caption": "Push",
                    "name": "UseWebFront",
                    "width": "60px",
                    "add": true,
                    "edit": { "type": "CheckBox" }
                },
                {
                    "caption": "Vestaboard",
                    "name": "UseVestaboard",
                    "width": "80px",
                    "add": true,
                    "edit": { "type": "CheckBox" }
                },
                {
                    "caption": "E-Mail",
                    "name": "UseEmail",
                    "width": "60px",
                    "add": true,
                    "edit": { "type": "CheckBox" }
                },
                {
                    "caption": "Sonos",
                    "name": "UseSonos",
                    "width": "60px",
                    "add": true,
                    "edit": { "type": "CheckBox" }
                },
                {
                    "caption": "HmIP MP3",
                    "name": "UseHmIP_MP3",
                    "width": "80px",
                    "add": false,
                    "edit": { "type": "CheckBox" }
                },
                {
                    "caption": "MP3 ID",
                    "name": "HmIP_MP3_SoundID",
                    "width": "80px",
                    "add": 0,
                    "edit": { "type": "NumberSpinner" }
                },
                {
                    "caption": "HmIP LED",
                    "name": "UseHmIP_LED",
                    "width": "80px",
