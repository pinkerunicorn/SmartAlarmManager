                    "caption": "LED Farbe",
                    "name": "HmIP_LED_Color",
                    "width": "100px",
                    "add": 6,
                    "edit": {
                        "type": "Select",
                        "options": [
                            { "caption": "Blau", "value": 1 },
                            { "caption": "Grün", "value": 2 },
                            { "caption": "Türkis", "value": 3 },
                            { "caption": "Rot", "value": 4 },
                            { "caption": "Violett", "value": 5 },
                            { "caption": "Gelb", "value": 6 },
                            { "caption": "Weiß", "value": 7 }
                        ]
                    }
                },
                {
                    "caption": "LED Modus",
                    "name": "HmIP_LED_Mode",
                    "width": "120px",
                    "add": 1,
                    "edit": {
                        "type": "Select",
                        "options": [
                            { "caption": "Dauerlicht", "value": 1 },
                            { "caption": "Blinken (L)", "value": 2 },
                            { "caption": "Blinken (M)", "value": 3 },
                            { "caption": "Blinken (S)", "value": 4 },
                            { "caption": "Blitzen (L)", "value": 5 },
                            { "caption": "Blitzen (M)", "value": 6 },
                            { "caption": "Blitzen (S)", "value": 7 },
                            { "caption": "Pulsieren (L)", "value": 8 },
                            { "caption": "Pulsieren (M)", "value": 9 },
                            { "caption": "Pulsieren (S)", "value": 10 }
                        ]
                    }
                }
